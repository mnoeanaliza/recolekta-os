rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    match /configuraciones/{documentId} {
      allow read, write: if signedIn();
    }

    match /catalogos/{documentId} {
      allow read, write: if signedIn();
    }

    match /agenda_flota/{documentId} {
      allow read, write: if signedIn();
    }

    match /usuarios_perfiles/{userEmail} {
      allow read, write: if signedIn();
    }

    match /alertas_flota/{documentId} {
      allow read, write: if signedIn();
    }

    match /registros_produccion/{documentId} {
      allow read, write: if signedIn();
    }

    match /registros_combustible/{documentId} {
      allow read, write: if signedIn();
    }

    match /registros_mantenimiento/{documentId} {
      allow read, write: if signedIn();
    }

    match /registros_horas_extras/{documentId} {
      allow read, write: if signedIn();
    }

    match /resumenes_operativos/{documentId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}

